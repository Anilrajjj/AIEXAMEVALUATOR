# Example environment variables for AIExamEvaluator
# Do NOT commit real secrets to source control.

# Gemini API key used for network-backed text extraction fallback.
# Set this only on the server or in your local environment (e.g., via a .env file or CI secret).
GEMINI_API_KEY=

# Optional: Custom Gemini-compatible extraction endpoint. If not set, a
# best-effort Google Generative Language endpoint pattern will be attempted.
GEMINI_API_URL=
